{
  "manifest_version": 3,
  "name": "BD ALAMIN Premium",
  "description": "⚡ BD ALAMIN · Smart Predict System v7.0 · Green Material UI",
  "version": "7.0.0",
  "permissions": ["storage"],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
